# ============================================================
# ALQASEMY TRADER — Production environment
# Rule-based only. NO AI / ML.
# ============================================================

# PostgreSQL/Supabase connection string
SUPABASE_DB_URL=postgresql+pg8000://USER:PASSWORD@HOST:5432/postgres

# REQUIRED for MT5 integration in production
MT5_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
REQUIRE_MT5_API_KEY=true
CONTROL_API_KEY=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
REQUIRE_CONTROL_API_KEY=true

# Trading universe
TRADING_SYMBOLS=EURUSD,XAUUSD

# Multi-timeframe roles
DIRECTION_TIMEFRAME=H1
CONFIRMATION_TIMEFRAME=M15
ENTRY_TIMEFRAME=M5

# Initial candle history requested from MT5 when the backend has no history
DIRECTION_CANDLE_LIMIT=200
CONFIRMATION_CANDLE_LIMIT=300
ENTRY_CANDLE_LIMIT=500
MIN_CANDLES_REQUIRED=60

# Database candle retention (per symbol + timeframe)
DIRECTION_CANDLE_RETENTION=5000
CONFIRMATION_CANDLE_RETENTION=10000
ENTRY_CANDLE_RETENTION=20000
CANDLE_SYNC_BATCH_SIZE=1000

# Legacy compatibility only; MTF limits above are authoritative
CANDLE_LIMIT=500

# Strategies
ENABLED_STRATEGIES=crossover,rsi
ALLOW_SMART_LIMITS=false
ALLOW_SCALPING=false

# Risk controls
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=1
MAX_PENDING_ORDERS=1
MAX_SYMBOL_EXPOSURE_LOTS=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MIN_MARGIN_LEVEL_PCT=300
MAX_MARGIN_USAGE_PCT=50
ACCOUNT_STALE_SECONDS=45
SIGNAL_COOLDOWN_MINUTES=5
PENDING_EXPIRY_MINUTES=60

# Protection geometry
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
REWARD_RISK=2.0
MAX_SPREAD_POINTS=30

# API/UI
CORS_ORIGINS=
WORKER_INTERVAL_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
